{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data including students and admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "cvUrl": { "type": "string", "description": "URL to uploaded CV/Resume" },
        "university": { "type": "string" },
        "major": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Question": {
      "title": "Question",
      "description": "Dataset of interview questions.",
      "type": "object",
      "properties": {
        "jobRole": { "type": "string" },
        "question": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobRole", "question", "difficulty", "createdAt"]
    },
    "ScoringParameter": {
      "title": "ScoringParameter",
      "description": "Parameters for evaluating interviews.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "weight": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "weight", "createdAt"]
    },
    "InterviewSession": {
      "title": "InterviewSession",
      "description": "Data for a single interview session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "jobRole": { "type": "string" },
        "language": { "type": "string" },
        "status": { "type": "string", "enum": ["in-progress", "completed", "analyzing"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "transcripts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "ai"] },
              "text": { "type": "string" },
              "timestamp": { "type": "number" }
            },
            "required": ["role", "text", "timestamp"]
          }
        },
        "analysis": { 
          "type": "object", 
          "description": "Detailed analysis of the answers",
          "properties": {
            "strengths": { "type": "array", "items": { "type": "string" } },
            "weaknesses": { "type": "array", "items": { "type": "string" } },
            "overallFeedback": { "type": "string" },
            "scores": {
              "type": "object",
              "properties": {
                "communication": { "type": "number" },
                "technical": { "type": "number" },
                "problemSolving": { "type": "number" },
                "cultureFit": { "type": "number" }
              }
            }
          }
        },
        "score": { "type": "number", "description": "Overall performance score" },
        "recommendation": { "type": "string", "description": "AI recommendation for improvement" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "jobRole", "language", "status", "startedAt", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Stores interview questions dataset."
    },
    "scoring_parameters/{parameterId}": {
      "schema": { "$ref": "#/entities/ScoringParameter" },
      "description": "Stores scoring parameters."
    },
    "sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/InterviewSession" },
      "description": "Stores interview sessions, transcripts, and evaluations."
    }
  }
}
